FROM docker.io/library/alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS builder

ARG TARGETPLATFORM

WORKDIR /workspace

COPY dist/${TARGETPLATFORM}/kube-green .
COPY LICENSE .

# Use distroless as minimal base image to package the manager binary
# Refer to https://github.com/GoogleContainerTools/distroless for more details
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/kube-green .
USER 65532:65532

ENTRYPOINT ["/kube-green"]
